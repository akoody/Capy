# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/capy

# Telegram Bot Configuration (тот же бот, что открыл Mini App — для напоминаний о задачах)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Срок жизни initData Mini App в секундах (по умолчанию сутки)
# TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# CORS выключен: фронт и API на одном домене (nginx проксирует /api).
# Для фронта на другом домене — список origin через запятую:
# CORS_ORIGINS=https://capy.example,http://localhost:5173

# AI Provider Configuration
# Configure at least one AI provider for analysis features
# The system will try providers in order: GigaChat → Gemini → DeepSeek → Groq

# GigaChat API (Recommended for Russian language)
# Format: client_id:client_secret (will be auto-encoded to Base64)
# Or provide Base64 encoded string directly
GIGACHAT_API_KEY=your_client_id:your_client_secret
# Корневой сертификат Минцифры (russian_trusted_root_ca.cer, PEM). Без него TLS к GigaChat не проверяется.
# GIGACHAT_CA_CERT_PATH=/etc/ssl/certs/russian_trusted_root_ca.pem

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API (голос: транскрипция + разбор текста)
# Без кавычек вокруг значения. При ключе организации: OPENAI_ORGANIZATION=org-...
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_ORGANIZATION=org_xxxxxxxx
# Транскрипция: по умолчанию gpt-4o-mini-transcribe (json). Альтернатива: whisper-1
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Разбор транскрипта в JSON: по умолчанию gpt-4o-mini
# OPENAI_INTERPRET_MODEL=gpt-5.4-mini

# Groq API (chat + optional fallback speech-to-text if OpenAI fails)
GROQ_API_KEY=your_groq_api_key_here

# Server Configuration (optional)
PORT=3001
# LOG_LEVEL=info
# Лимит запросов на аккаунт
# THROTTLE_LIMIT=240
# THROTTLE_TTL_SECONDS=60
# Swagger UI на /docs
# DOCS_ENABLED=false
